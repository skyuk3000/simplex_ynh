#!/bin/bash
source /usr/share/yunohost/helpers

panel_tool="$YNH_APP_BASEDIR/conf/panel.py"

_get_panel_setting() {
    python3 "$panel_tool" get "$1"
}

_set_panel_setting() {
    # Preserve the current INI before applying a setting and restart SMP.
    local backup
    backup="$(mktemp)"
    cp -a /etc/opt/simplex/smp-server.ini "$backup"
    if ! python3 "$panel_tool" set "$1" "$2" || ! systemctl restart simplex; then
        cp -a "$backup" /etc/opt/simplex/smp-server.ini
        systemctl restart simplex || true
        rm -f "$backup"
        ynh_die --message="Failed to apply SimpleX configuration, previous file restored"
    fi
    rm -f "$backup"
}

getter__smp_retention_days() { _get_panel_setting smp_retention_days; }
setter__smp_retention_days() { _set_panel_setting smp_retention_days "$smp_retention_days"; }

getter__smp_stats_enabled() { _get_panel_setting smp_stats_enabled; }
setter__smp_stats_enabled() { _set_panel_setting smp_stats_enabled "$smp_stats_enabled"; }

getter__smp_operator_name() { _get_panel_setting smp_operator_name; }
setter__smp_operator_name() { _set_panel_setting smp_operator_name "$smp_operator_name"; }

getter__smp_admin_contact() { _get_panel_setting smp_admin_contact; }
setter__smp_admin_contact() { _set_panel_setting smp_admin_contact "$smp_admin_contact"; }

ynh_app_config_run "$1"
